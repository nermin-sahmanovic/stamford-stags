# Copy to .env.local for development. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from `npx supabase status` locally, or the project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # public anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY. Used only in src/lib/supabase/admin.ts

# Microsoft Graph email (team mailbox, client credentials)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=                   # e.g. team@stamfordstags.com

# Join form spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/* routes
CRON_SECRET=
