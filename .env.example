# Copy to .env.local for development. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from `npx supabase status` locally, or the project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # public anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY. Used only in src/lib/supabase/admin.ts

# Email (Resend). Setup steps: docs/EMAIL_SETUP.md
RESEND_API_KEY=                         # SERVER ONLY. Sending access, restricted to the team domain
EMAIL_FROM=                             # e.g. Stamford Stags <team@send.example.com>; empty = onboarding@resend.dev (dev only)
TEAM_INBOX=                             # where Contact-form messages go (a real inbox someone reads)
# DEV SAFETY: anything but "live" redirects EVERY email to EMAIL_DEV_REDIRECT, with the intended
# recipient listed at the top. Without RESEND_API_KEY or EMAIL_DEV_REDIRECT, emails are only logged.
# Set EMAIL_MODE=live only on the production deployment, at go-live.
EMAIL_MODE=redirect
EMAIL_DEV_REDIRECT=                     # your own address

# Join/Contact spam protection (Cloudflare Turnstile). Leave empty in development to use
# Cloudflare's always-pass test keys. Real keys are required in production (forms fail closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protects /api/cron/* routes (Vercel cron sends it as "Authorization: Bearer <secret>")
CRON_SECRET=
